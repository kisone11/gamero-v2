# ============================================================
# .env.example — 环境变量模板
# 使用方式：cp .env.example .env，然后按需修改
# 注意：.env 文件包含敏感信息，已加入 .gitignore，请勿提交
# ============================================================

# ----------------------------------------
# 服务基础配置
# ----------------------------------------
# 应用监听端口
SERVER_PORT=8080

# 运行模式：debug（开发）| release（生产）| test（测试）
GAMERO_SERVER_MODE=debug

# ----------------------------------------
# PostgreSQL 数据库
# ----------------------------------------
POSTGRES_USER=gamero
POSTGRES_PASSWORD=gamero123
POSTGRES_DB=gamero
POSTGRES_PORT=5432

# Viper 映射（应用内部使用，覆盖 config.yaml）
GAMERO_DATABASE_HOST=postgres
GAMERO_DATABASE_PORT=5432
GAMERO_DATABASE_USER=gamero
GAMERO_DATABASE_PASSWORD=gamero123
GAMERO_DATABASE_DBNAME=gamero
GAMERO_DATABASE_SSLMODE=disable

# ----------------------------------------
# Redis
# ----------------------------------------
REDIS_PORT=6379
# 留空表示无密码，生产环境建议设置强密码
REDIS_PASSWORD=

GAMERO_REDIS_HOST=redis
GAMERO_REDIS_PORT=6379
GAMERO_REDIS_PASSWORD=

# ----------------------------------------
# 对象存储（S3 兼容，支持腾讯云 COS / 阿里云 OSS / AWS S3 等）
# ----------------------------------------
GAMERO_STORAGE_PROVIDER=cos
GAMERO_STORAGE_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com
GAMERO_STORAGE_REGION=ap-guangzhou
GAMERO_STORAGE_ACCESS_KEY_ID=your-access-key-id
GAMERO_STORAGE_SECRET_ACCESS_KEY=your-secret-access-key
GAMERO_STORAGE_BUCKET_NAME=gamero-1234567890
GAMERO_STORAGE_BASE_URL=https://gamero-1234567890.cos.ap-guangzhou.myqcloud.com
GAMERO_STORAGE_FORCE_PATH_STYLE=false

# ----------------------------------------
# JWT 密钥（生产环境必须替换为强随机字符串）
# 生成示例：openssl rand -base64 32
# ----------------------------------------
GAMERO_JWT_ACCESS_SECRET=change-me-access-secret-use-openssl-rand-base64-32
GAMERO_JWT_REFRESH_SECRET=change-me-refresh-secret-use-openssl-rand-base64-32
# Access Token 有效期（秒），默认 2 小时
GAMERO_JWT_ACCESS_EXPIRE=7200
# Refresh Token 有效期（秒），默认 7 天
GAMERO_JWT_REFRESH_EXPIRE=604800

# ----------------------------------------
# 短信服务（按需填写）
# ----------------------------------------
# 服务商：tencent | aliyun
# GAMERO_SMS_PROVIDER=tencent
# GAMERO_SMS_SECRET_ID=your-secret-id
# GAMERO_SMS_SECRET_KEY=your-secret-key
# GAMERO_SMS_SDK_APP_ID=your-sdk-app-id
# GAMERO_SMS_SIGN_NAME=Gamero
# GAMERO_SMS_TEMPLATE_ID=your-template-id

# ----------------------------------------
# 邮件服务（按需填写）
# ----------------------------------------
# GAMERO_EMAIL_HOST=smtp.example.com
# GAMERO_EMAIL_PORT=465
# GAMERO_EMAIL_USERNAME=noreply@gamero.com
# GAMERO_EMAIL_PASSWORD=your-email-password
# GAMERO_EMAIL_FROM=Gamero <noreply@gamero.com>
# GAMERO_EMAIL_SSL=true

# ----------------------------------------
# 支付配置（按需填写）
# ----------------------------------------
# 支付渠道：mock（测试）| wechat | alipay
# GAMERO_PAYMENT_PROVIDER=mock

# 微信支付
# GAMERO_PAYMENT_WECHAT_APP_ID=
# GAMERO_PAYMENT_WECHAT_MCH_ID=
# GAMERO_PAYMENT_WECHAT_API_KEY=

# 支付宝
# GAMERO_PAYMENT_ALIPAY_APP_ID=
# GAMERO_PAYMENT_ALIPAY_PRIVATE_KEY=
# GAMERO_PAYMENT_ALIPAY_PUBLIC_KEY=

# 银行卡信息加密密钥（32字节 hex，64字符），留空则不加密（仅开发用）
# 生成方式：openssl rand -hex 32
# GAMERO_PAYMENT_ENCRYPTION_KEY=

# ----------------------------------------
# 超级管理员初始化（首次部署时填写，之后可删除）
# ----------------------------------------
# 首次运行 migrate 时自动创建超管账号
# GAMERO_SEED_ADMIN_EMAIL=admin@gamero.com
# GAMERO_SEED_ADMIN_PASSWORD=YourStrongPassword123!

# ----------------------------------------
# 消息队列（按需填写）
# ----------------------------------------
# 队列模式：memory（内存，开发用）| kafka（生产用）
GAMERO_MQ_PROVIDER=memory
# Kafka 配置（provider=kafka 时填写）
# GAMERO_MQ_BROKERS=kafka:9092
# GAMERO_MQ_GROUP_ID=gamero

# ----------------------------------------
# 可观测性（按需填写）
# ----------------------------------------
# Prometheus 指标
GAMERO_OBSERVABILITY_METRICS_ENABLED=true
GAMERO_OBSERVABILITY_METRICS_PATH=/metrics

# 链路追踪（OpenTelemetry）
GAMERO_OBSERVABILITY_TRACING_ENABLED=false
# GAMERO_OBSERVABILITY_TRACING_EXPORTER=jaeger
# GAMERO_OBSERVABILITY_TRACING_ENDPOINT=http://jaeger:14268/api/traces
